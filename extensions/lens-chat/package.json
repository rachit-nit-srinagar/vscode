{
  "name": "lens-chat",
  "displayName": "Lens Chat",
  "description": "Chat with the Lens coding assistant.",
  "version": "0.0.1",
  "publisher": "vscode",
  "license": "MIT",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "extensionKind": [
    "ui",
    "workspace"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onView:lens-chat.view",
    "onCommand:lens-chat.open"
  ],
  "contributes": {
    "commands": [
      {
        "command": "lens-chat.open",
        "title": "Lens: Open Chat",
        "category": "Lens"
      }
    ],
    "viewsContainers": {
      "secondarySideBar": [
        {
          "id": "lens",
          "title": "Lens",
          "icon": "$(sparkle)"
        }
      ]
    },
    "views": {
      "lens": [
        {
          "id": "lens-chat.view",
          "name": "Chat",
          "type": "webview"
        }
      ]
    }
  },
  "scripts": {
    "compile": "gulp compile-extension:lens-chat",
    "watch": "gulp watch-extension:lens-chat"
  },
  "devDependencies": {
    "@types/node": "24.x"
  }
}
